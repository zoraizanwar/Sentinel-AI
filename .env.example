# Sentinel AI Environment Configuration (Localhost Only)

# Application Settings
PROJECT_NAME="Sentinel AI"
VERSION="1.0.0"
ENVIRONMENT="development"

# Database Configuration (PostgreSQL primary with local asyncpg)
DATABASE_URL=postgresql+asyncpg://<username>:<password>@127.0.0.1:5432/sentinel_ai
# SQLite Testing Fallback: sqlite+aiosqlite:///./sentinel_ai.db

# JWT Authentication
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480  # 8 hours

# Storage Directories
UPLOAD_BASE_DIR=data/uploads
REPORTS_BASE_DIR=data/reports

# File Ingestion Limits
MAX_UPLOAD_SIZE_BYTES=524288000  # 500 MB
MIN_DATASET_ROWS=50

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
